# Copy to .env. Everything except PORT is optional in development.
PORT=4000
FRONTEND_URL=http://localhost:5173
# Where the AI services can reach this API for callbacks
PUBLIC_API_URL=http://localhost:4000

# --- Data ---
# live (default): findings are derived from scans of connected GitHub repos and the
# bundled sample repos (fixtures/repos/*), persisted to data/state-live.json.
# demo: the original hand-written fixtures (UI work, screenshots).
DATA_MODE=live
TENANT_ID=t_default
PROJECT_NAME=payments-platform
# Bundled sample repos scanned alongside GitHub repos. Empty = only real repos.
SAMPLE_REPOS=payments-service
# Scan on first start so the product has graph-backed data immediately.
SCAN_ON_START=true

# --- AI service (agentshield-ai repo; `make up` there starts it on :8090) ---
# Leave empty to run in replay mode with fixture results.
AI_SERVICE_URL=http://localhost:8090
# Shared HMAC secret for requests to and callbacks from the AI service.
# MUST equal AGENTSHIELD_SHARED_SECRET in the AI service's .env.
AI_SHARED_SECRET=
# Remote AI jobs that never report back are failed after this long.
AI_JOB_TIMEOUT_MS=600000

# --- GitHub App (optional until you connect real repos) ---
# App permissions: Contents read & write, Pull requests read & write, Metadata read.
# Subscribe to the "push" event so merges rescan the project.
GITHUB_APP_ID=
GITHUB_APP_SLUG=agentshield-dev
GITHUB_APP_PRIVATE_KEY_PATH=./agentshield.private-key.pem
GITHUB_WEBHOOK_SECRET=
STATE_SECRET=change-me-to-a-long-random-string

# --- Dev user until login exists ---
DEV_USER_NAME=S. Shruti
DEV_USER_ROLE=admin
