# Copy to .env. Everything except PORT is optional in development.
PORT=4000
FRONTEND_URL=http://localhost:5173
# Where the AI services can reach this API for callbacks
PUBLIC_API_URL=http://localhost:4000

# --- AI services (built by the AI team; see docs/ai-integration.md) ---
# Leave empty to run in replay mode with fixture results.
AI_SERVICE_URL=
# Shared HMAC secret for requests to and callbacks from the AI service
AI_SHARED_SECRET=

# --- GitHub App (optional until you connect real repos) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=agentshield-dev
GITHUB_APP_PRIVATE_KEY_PATH=./agentshield.private-key.pem
GITHUB_WEBHOOK_SECRET=
STATE_SECRET=change-me-to-a-long-random-string

# --- Dev user until login exists ---
DEV_USER_NAME=S. Shruti
DEV_USER_ROLE=admin
